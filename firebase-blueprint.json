    "Product": {
      "title": "Product",
      "description": "Storefront hardware catalog item with real-time stock tracking and external image URL.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
