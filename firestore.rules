rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Primitives
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'saikatcomputervillage@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function initialAdminProofHash() {
      return 'a262fc9b6d783e79cbd1f1bbc179122bdde31a8c1708c8164360886bb045ba40';
    }

    function hasValidCredProofHash() {
      return exists(/databases/$(database)/documents/adminConfig/credentials)
        && ('proofHash' in get(/databases/$(database)/documents/adminConfig/credentials).data)
        && get(/databases/$(database)/documents/adminConfig/credentials).data.proofHash is string
        && get(/databases/$(database)/documents/adminConfig/credentials).data.proofHash.size() == 64;
    }

    function isValidAdminProofToken(proof) {
      return proof is string
        && proof.size() == 64
        && proof.matches('^[a-f0-9]+$')
        && (
          (hasValidCredProofHash() && hashing.sha256(proof).toHexString().lower() == get(/databases/$(database)/documents/adminConfig/credentials).data.proofHash)
          || (!hasValidCredProofHash() && hashing.sha256(proof).toHexString().lower() == initialAdminProofHash())
        );
    }

    function isValidAdminProofBatch(auditId) {
      return isValidId(auditId)
        && existsAfter(/databases/$(database)/documents/adminProofs/$(auditId))
        && getAfter(/databases/$(database)/documents/adminProofs/$(auditId)).data.createdAt == request.time;
    }

    function isValidStaffProofToken(staffId, proof) {
      return isValidId(staffId)
        && proof is string
        && proof.size() == 64
        && proof.matches('^[a-f0-9]+$')
        && exists(/databases/$(database)/documents/staffSecrets/$(staffId))
        && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.active == true
        && hashing.sha256(proof).toHexString().lower() == get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.proofHash;
    }

    function isValidStaffLoginBatch(staffId, auditId) {
      return isValidId(staffId)
        && isValidId(auditId)
        && existsAfter(/databases/$(database)/documents/staffProofs/$(auditId))
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.staffId == staffId
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.createdAt == request.time
        && exists(/databases/$(database)/documents/staffSecrets/$(staffId))
        && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.active == true;
    }

    function isValidStaffPermissionBatch(staffId, auditId, perm) {
      return isValidStaffLoginBatch(staffId, auditId) && (
        (perm == 'add' && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canAddProduct == true) ||
        (perm == 'edit' && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canEditProduct == true) ||
        (perm == 'delete' && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canDeleteProduct == true) ||
        (perm == 'orders' && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canManageOrders == true)
      );
    }

    function canUserAddPost() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.canAddPost == true;
    }

    function canUserEditPost() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.canEditPost == true;
    }

    // ---------------------------------------------------------
    // Validation Blueprints (Pure static checks, no DB reads)
    // ---------------------------------------------------------
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidAdminProof(data) {
      return data.keys().hasAll(['proof', 'createdAt'])
        && data.keys().hasOnly(['proof', 'createdAt'])
        && data.proof is string && data.proof.size() == 64 && data.proof.matches('^[a-f0-9]+$')
        && data.createdAt is timestamp;
    }

    function isValidAdminCredential(data) {
      return data.keys().hasAll(['username', 'proofHash', 'auditId', 'updatedAt'])
        && data.keys().hasOnly(['username', 'proofHash', 'auditId', 'updatedAt'])
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 60
        && data.proofHash is string && data.proofHash.size() == 64 && data.proofHash.matches('^[a-f0-9]+$')
        && isValidId(data.auditId)
        && data.updatedAt is timestamp;
    }

    function isValidStaffProof(data) {
      return data.keys().hasAll(['staffId', 'proof', 'createdAt'])
        && data.keys().hasOnly(['staffId', 'proof', 'createdAt'])
        && isValidId(data.staffId)
        && data.staffId.size() >= 3 && data.staffId.size() <= 60
        && data.proof is string && data.proof.size() == 64 && data.proof.matches('^[a-f0-9]+$')
        && data.createdAt is timestamp;
    }

    function isValidStaffSecret(data) {
      return data.keys().hasAll([
          'staffId', 'proofHash', 'active', 'canAddProduct', 'canEditProduct',
          'canDeleteProduct', 'canManageOrders', 'canViewAnalytics', 'auditId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'staffId', 'proofHash', 'active', 'canAddProduct', 'canEditProduct',
          'canDeleteProduct', 'canManageOrders', 'canViewAnalytics', 'auditId', 'updatedAt'
        ])
        && isValidId(data.staffId)
        && data.staffId.size() >= 3 && data.staffId.size() <= 60
        && data.proofHash is string && data.proofHash.size() == 64 && data.proofHash.matches('^[a-f0-9]+$')
        && data.active is bool
        && data.canAddProduct is bool
        && data.canEditProduct is bool
        && data.canDeleteProduct is bool
        && data.canManageOrders is bool
        && data.canViewAnalytics is bool
        && isValidId(data.auditId)
        && data.updatedAt is timestamp;
    }

    function isValidStaffAccount(data) {
      return data.keys().hasAll([
          'staffId', 'username', 'displayName', 'active', 'status',
          'canAddProduct', 'canEditProduct', 'canDeleteProduct',
          'canManageOrders', 'canViewAnalytics', 'loginCount', 'auditId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'staffId', 'username', 'displayName', 'active', 'status',
          'canAddProduct', 'canEditProduct', 'canDeleteProduct',
          'canManageOrders', 'canViewAnalytics', 'loginCount', 'auditId',
          'lastLoginAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.staffId) && data.staffId.size() >= 3 && data.staffId.size() <= 60
        && isValidId(data.username) && data.username.size() >= 3 && data.username.size() <= 60
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.active is bool
        && data.status in ['active', 'suspended', 'deleted']
        && data.canAddProduct is bool
        && data.canEditProduct is bool
        && data.canDeleteProduct is bool
        && data.canManageOrders is bool
        && data.canViewAnalytics is bool
        && data.loginCount is int && data.loginCount >= 0 && data.loginCount <= 1000000
        && isValidId(data.auditId)
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserAccess(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'loginCount',
          'canAddPost', 'canEditPost', 'lastLoginAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'loginCount',
          'canAddPost', 'canEditPost', 'auditId', 'lastLoginAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 1000
        && data.loginCount is int && data.loginCount >= 1 && data.loginCount <= 1000000
        && data.canAddPost is bool
        && data.canEditPost is bool
        && (!('auditId' in data) || isValidId(data.auditId))
        && data.lastLoginAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'phone',
          'defaultAddress', 'city', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'phone',
          'defaultAddress', 'city', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 1000
        && data.phone is string && data.phone.size() <= 40
        && data.defaultAddress is string && data.defaultAddress.size() <= 300
        && data.city is string && data.city.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
          'stock', 'soldCount', 'imageUrl', 'summary', 'specs',
          'featured', 'status', 'lastOrderId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
          'stock', 'soldCount', 'imageUrl', 'summary', 'specs',
          'featured', 'status', 'lastOrderId', 'auditId', 'staffId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 60
        && data.category in ['Laptops', 'Processors', 'Graphics Cards', 'Monitors', 'Peripherals', 'Networking', 'Storage']
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 48 && data.sku.matches('^[a-zA-Z0-9_\\-]+$')
        && data.price is number && data.price > 0 && data.price <= 10000000
        && data.compareAtPrice is number && data.compareAtPrice >= 0 && data.compareAtPrice <= 10000000
        && data.stock is int && data.stock >= 0 && data.stock <= 100000
        && data.soldCount is int && data.soldCount >= 0 && data.soldCount <= 10000000
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 1000
        && data.imageUrl.matches('^(https?://|/src/assets/images/).+$')
        && data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 800
        && data.specs is list && data.specs.size() <= 16
        && (
          data.specs.size() == 0 || (
            data.specs[0] is map
            && data.specs[0].keys().hasAll(['label', 'value'])
            && data.specs[0].keys().hasOnly(['label', 'value'])
            && data.specs[0].label is string && data.specs[0].label.size() >= 1 && data.specs[0].label.size() <= 60
            && data.specs[0].value is string && data.specs[0].value.size() >= 1 && data.specs[0].value.size() <= 120
          )
        )
        && data.featured is bool
        && data.status in ['active', 'draft', 'archived']
        && data.lastOrderId is string && data.lastOrderId.size() >= 1 && data.lastOrderId.size() <= 128
        && (!('auditId' in data) || isValidId(data.auditId))
        && (!('staffId' in data) || isValidId(data.staffId))
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerEmail',
          'customerPhone', 'shippingAddress', 'city', 'paymentMethod',
          'items', 'subtotal', 'shippingFee', 'totalAmount',
          'status', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerEmail',
          'customerPhone', 'shippingAddress', 'city', 'paymentMethod',
          'items', 'subtotal', 'shippingFee', 'totalAmount',
          'status', 'notes', 'auditId', 'staffId', 'createdAt', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 40
        && data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 300
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.paymentMethod in ['cod', 'card_on_delivery', 'bank_transfer']
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 20
        && data.items[0] is map
        && data.items[0].keys().hasAll(['productId', 'title', 'sku', 'price', 'quantity', 'imageUrl'])
        && data.items[0].keys().hasOnly(['productId', 'title', 'sku', 'price', 'quantity', 'imageUrl'])
        && data.items[0].productId is string && isValidId(data.items[0].productId)
        && data.items[0].title is string && data.items[0].title.size() >= 1 && data.items[0].title.size() <= 160
        && data.items[0].sku is string && data.items[0].sku.size() >= 1 && data.items[0].sku.size() <= 48
        && data.items[0].price is number && data.items[0].price > 0
        && data.items[0].quantity is int && data.items[0].quantity >= 1 && data.items[0].quantity <= 50
        && data.items[0].imageUrl is string && data.items[0].imageUrl.size() <= 1000
        && data.subtotal is number && data.subtotal > 0
        && data.shippingFee is number && data.shippingFee >= 0 && data.shippingFee <= 10000
        && data.totalAmount is number && data.totalAmount == data.subtotal + data.shippingFee
        && data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled']
        && data.notes is string && data.notes.size() <= 500
        && (!('auditId' in data) || isValidId(data.auditId))
        && (!('staffId' in data) || isValidId(data.staffId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection Rules (Auth/Proof -> Static Validation -> Relational)
    // ---------------------------------------------------------
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(adminId) && isValidAdmin(incoming())
        && incoming().uid == adminId
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(adminId) && adminId != request.auth.uid && isAdmin();
    }

    match /adminProofs/{proofId} {
      allow read: if false;
      allow create: if isValidId(proofId)
        && isValidAdminProof(incoming())
        && incoming().createdAt == request.time
        && isValidAdminProofToken(incoming().proof);
      allow update, delete: if false;
    }

    match /adminConfig/{configId} {
      allow get, list: if false;
      allow create, update: if isValidId(configId)
        && configId == 'credentials'
        && isValidAdminCredential(incoming())
        && incoming().updatedAt == request.time
        && (isAdmin() || isValidAdminProofBatch(incoming().auditId));
      allow delete: if false;
    }

    match /staffProofs/{proofId} {
      allow read: if false;
      allow create: if isValidId(proofId)
        && isValidStaffProof(incoming())
        && incoming().createdAt == request.time
        && isValidStaffProofToken(incoming().staffId, incoming().proof);
      allow update, delete: if false;
    }

    match /staffSecrets/{staffId} {
      allow get, list: if false;
      allow create: if isValidId(staffId)
        && isValidStaffSecret(incoming())
        && incoming().staffId == staffId
        && incoming().updatedAt == request.time
        && (isAdmin() || isValidAdminProofBatch(incoming().auditId));
      allow update: if isValidId(staffId)
        && isValidStaffSecret(incoming())
        && incoming().staffId == existing().staffId
        && incoming().updatedAt == request.time
        && (isAdmin() || isValidAdminProofBatch(incoming().auditId));
      allow delete: if false;
    }

    match /staffAccounts/{staffId} {
      allow get: if isValidId(staffId) && (existing().status in ['active', 'suspended'] || isAdmin());
      allow list: if resource.data.status in ['active', 'suspended'] || isAdmin();
      allow create: if isValidId(staffId)
        && isValidStaffAccount(incoming())
        && incoming().staffId == staffId
        && incoming().loginCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || isValidAdminProofBatch(incoming().auditId));
      allow update: if isValidId(staffId)
        && isValidStaffAccount(incoming())
        && incoming().staffId == existing().staffId
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Super Admin updates manager status or checkbox permissions
          (
            (isAdmin() || isValidAdminProofBatch(incoming().auditId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'active', 'status',
              'canAddProduct', 'canEditProduct', 'canDeleteProduct',
              'canManageOrders', 'canViewAnalytics', 'auditId', 'updatedAt'
            ])
          ) ||
          // Tier 2: Verified manager records login event
          (
            isValidStaffLoginBatch(staffId, incoming().auditId)
            && incoming().loginCount == existing().loginCount + 1
            && incoming().lastLoginAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'loginCount', 'lastLoginAt', 'auditId', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /userAccess/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isValidUserAccess(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            isVerifiedUser()
            && isOwner(userId)
            && incoming().loginCount == 1
            && incoming().canAddPost == false
            && incoming().canEditPost == false
            && incoming().lastLoginAt == request.time
            && !('auditId' in incoming())
          ) ||
          isAdmin() ||
          (('auditId' in incoming()) && isValidAdminProofBatch(incoming().auditId))
        );
      allow update: if isValidId(userId)
        && isValidUserAccess(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (
              isAdmin() ||
              (('auditId' in incoming()) && isValidAdminProofBatch(incoming().auditId))
            )
            && incoming().diff(existing()).affectedKeys().hasOnly(['canAddPost', 'canEditPost', 'auditId', 'updatedAt'])
          ) ||
          (
            isVerifiedUser()
            && isOwner(userId)
            && incoming().loginCount == existing().loginCount + 1
            && incoming().canAddPost == existing().canAddPost
            && incoming().canEditPost == existing().canEditPost
            && incoming().lastLoginAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'loginCount', 'lastLoginAt', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'phone', 'defaultAddress', 'city', 'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().status == 'active' || isAdmin());
      allow list: if resource.data.status == 'active' || isAdmin();
      allow create: if isValidId(productId) && isValidProduct(incoming())
        && incoming().soldCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().createdBy == request.auth.uid) ||
          (canUserAddPost() && incoming().createdBy == request.auth.uid && !('auditId' in incoming()) && !('staffId' in incoming())) ||
          (('auditId' in incoming()) && !('staffId' in incoming()) && isValidAdminProofBatch(incoming().auditId) && incoming().createdBy == 'admin_portal') ||
          (('auditId' in incoming()) && ('staffId' in incoming()) && isValidStaffPermissionBatch(incoming().staffId, incoming().auditId, 'add') && incoming().createdBy == incoming().staffId)
        );
      allow update: if isValidId(productId) && isValidProduct(incoming()) && (
        // Tier 1a: Super Admin full catalog & inventory update
        (
          (
            isAdmin() ||
            (('auditId' in incoming()) && !('staffId' in incoming()) && isValidAdminProofBatch(incoming().auditId))
          )
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
            'stock', 'imageUrl', 'summary', 'specs', 'featured', 'status', 'auditId', 'updatedAt'
          ])
        ) ||
        // Tier 1b: Manager with canEditProduct modifying active/draft product or stock
        (
          ('auditId' in incoming())
          && ('staffId' in incoming())
          && isValidStaffPermissionBatch(incoming().staffId, incoming().auditId, 'edit')
          && incoming().status in ['active', 'draft']
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
            'stock', 'imageUrl', 'summary', 'specs', 'featured', 'status', 'staffId', 'auditId', 'updatedAt'
          ])
        ) ||
        // Tier 1c: Manager with canDeleteProduct archiving product
        (
          ('auditId' in incoming())
          && ('staffId' in incoming())
          && isValidStaffPermissionBatch(incoming().staffId, incoming().auditId, 'delete')
          && incoming().status == 'archived'
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'staffId', 'auditId', 'updatedAt'
          ])
        ) ||
        // Tier 1d: Storefront permitted editor (canEditPost) modifying active/draft listing
        (
          canUserEditPost()
          && !('auditId' in incoming())
          && !('staffId' in incoming())
          && incoming().status in ['active', 'draft']
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
            'stock', 'imageUrl', 'summary', 'specs', 'featured', 'status', 'updatedAt'
          ])
        ) ||
        // Tier 2: Verified Customer atomic stock deduction coupled with Order creation
        (
          isVerifiedUser()
          && existing().status == 'active'
          && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'soldCount', 'lastOrderId', 'updatedAt'])
          && incoming().stock < existing().stock
          && incoming().stock >= 0
          && incoming().soldCount == existing().soldCount + (existing().stock - incoming().stock)
          && incoming().updatedAt == request.time
          && isValidId(incoming().lastOrderId)
          && existsAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId))
          && getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId)).data.createdAt == request.time
        )
      );
      allow delete: if isVerifiedUser() && isValidId(productId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/products/$(incoming().items[0].productId))
        && get(/databases/$(database)/documents/products/$(incoming().items[0].productId)).data.price == incoming().items[0].price
        && (incoming().items.size() > 1 || incoming().subtotal == incoming().items[0].price * incoming().items[0].quantity);
      allow update: if isValidId(orderId) && isValidOrder(incoming())
        && incoming().orderNumber == existing().orderNumber
        && incoming().userId == existing().userId
        && incoming().items == existing().items
        && incoming().subtotal == existing().subtotal
        && incoming().shippingFee == existing().shippingFee
        && incoming().totalAmount == existing().totalAmount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1a: Super Admin order lifecycle management
          (
            (
              isAdmin() ||
              (('auditId' in incoming()) && !('staffId' in incoming()) && isValidAdminProofBatch(incoming().auditId))
            )
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'auditId', 'updatedAt'])
          ) ||
          // Tier 1b: Manager with canManageOrders permission
          (
            ('auditId' in incoming())
            && ('staffId' in incoming())
            && isValidStaffPermissionBatch(incoming().staffId, incoming().auditId, 'orders')
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'staffId', 'auditId', 'updatedAt'])
          ) ||
          // Tier 2: Customer may only cancel their own pending order
          (
            isVerifiedUser()
            && existing().userId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }
  }
}
