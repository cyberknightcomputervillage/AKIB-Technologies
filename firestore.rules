rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Primitives
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'saikatcomputervillage@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function initialAdminProofHash() {
      return 'a262fc9b6d783e79cbd1f1bbc179122bdde31a8c1708c8164360886bb045ba40';
    }

    function hasValidCredProofHash() {
      return exists(/databases/$(database)/documents/adminConfig/credentials)
        && ('proofHash' in get(/databases/$(database)/documents/adminConfig/credentials).data)
        && get(/databases/$(database)/documents/adminConfig/credentials).data.proofHash is string
        && get(/databases/$(database)/documents/adminConfig/credentials).data.proofHash.size() == 64;
    }

    function isValidAdminProofToken(proof) {
      return proof is string
        && proof.size() == 64
        && proof.matches('^[a-f0-9]+$')
        && (
          (hasValidCredProofHash() && hashing.sha256(proof).toHexString().lower() == get(/databases/$(database)/documents/adminConfig/credentials).data.proofHash)
          || (!hasValidCredProofHash() && hashing.sha256(proof).toHexString().lower() == initialAdminProofHash())
        );
    }

    function isValidAdminProofBatch(auditId) {
      return isValidId(auditId)
        && existsAfter(/databases/$(database)/documents/adminProofs/$(auditId))
        && getAfter(/databases/$(database)/documents/adminProofs/$(auditId)).data.createdAt == request.time;
    }

    function isValidStaffProofToken(staffId, proof) {
      return isValidId(staffId)
        && proof is string
        && proof.size() == 64
        && proof.matches('^[a-f0-9]+$')
        && exists(/databases/$(database)/documents/staffSecrets/$(staffId))
        && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.active == true
        && hashing.sha256(proof).toHexString().lower() == get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.proofHash;
    }

    function isValidStaffLoginBatch(staffId, auditId) {
      return isValidId(staffId)
        && isValidId(auditId)
        && existsAfter(/databases/$(database)/documents/staffProofs/$(auditId))
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.staffId == staffId
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.createdAt == request.time
        && exists(/databases/$(database)/documents/staffSecrets/$(staffId))
        && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.active == true;
    }

    function isValidStaffPermissionBatch(staffId, auditId, perm) {
      return isValidStaffLoginBatch(staffId, auditId) && (
        (perm == 'add' && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canAddProduct == true) ||
        (perm == 'edit' && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canEditProduct == true) ||
        (perm == 'delete' && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canDeleteProduct == true) ||
        (perm == 'orders' && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canManageOrders == true)
      );
    }

    function isValidStaffErpAnyBatch(staffId, auditId) {
      return isValidId(staffId)
        && isValidId(auditId)
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.staffId == staffId
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.createdAt == request.time
        && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.active == true
        && (
          get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canAddProduct == true ||
          get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canEditProduct == true ||
          get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canManageOrders == true
        );
    }

    function isValidStaffErpSetupBatch(staffId, auditId) {
      return isValidId(staffId)
        && isValidId(auditId)
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.staffId == staffId
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.createdAt == request.time
        && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.active == true
        && (
          get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canAddProduct == true ||
          get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canEditProduct == true
        );
    }

    function isValidStaffErpOrderBatch(staffId, auditId) {
      return isValidId(staffId)
        && isValidId(auditId)
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.staffId == staffId
        && getAfter(/databases/$(database)/documents/staffProofs/$(auditId)).data.createdAt == request.time
        && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.active == true
        && get(/databases/$(database)/documents/staffSecrets/$(staffId)).data.canManageOrders == true;
    }

    function isAuthorizedErpSetup(data) {
      return isAdmin()
        || (!('staffId' in data) && isValidAdminProofBatch(data.auditId))
        || (('staffId' in data) && isValidStaffErpSetupBatch(data.staffId, data.auditId));
    }

    function isAuthorizedErpOrder(data) {
      return isAdmin()
        || (!('staffId' in data) && isValidAdminProofBatch(data.auditId))
        || (('staffId' in data) && isValidStaffErpOrderBatch(data.staffId, data.auditId));
    }

    function isAuthorizedErpAny(data) {
      return isAdmin()
        || (!('staffId' in data) && isValidAdminProofBatch(data.auditId))
        || (('staffId' in data) && isValidStaffErpAnyBatch(data.staffId, data.auditId));
    }

    function canUserAddPost() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.canAddPost == true;
    }

    function canUserEditPost() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.canEditPost == true;
    }

    // ---------------------------------------------------------
    // Validation Blueprints (Pure static checks, no DB reads)
    // ---------------------------------------------------------
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidAdminProof(data) {
      return data.keys().hasAll(['proof', 'createdAt'])
        && data.keys().hasOnly(['proof', 'createdAt'])
        && data.proof is string && data.proof.size() == 64 && data.proof.matches('^[a-f0-9]+$')
        && data.createdAt is timestamp;
    }

    function isValidAdminCredential(data) {
      return data.keys().hasAll(['username', 'proofHash', 'auditId', 'updatedAt'])
        && data.keys().hasOnly(['username', 'proofHash', 'auditId', 'updatedAt'])
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 60
        && data.proofHash is string && data.proofHash.size() == 64 && data.proofHash.matches('^[a-f0-9]+$')
        && isValidId(data.auditId)
        && data.updatedAt is timestamp;
    }

    function isValidStaffProof(data) {
      return data.keys().hasAll(['staffId', 'proof', 'createdAt'])
        && data.keys().hasOnly(['staffId', 'proof', 'createdAt'])
        && isValidId(data.staffId)
        && data.staffId.size() >= 3 && data.staffId.size() <= 60
        && data.proof is string && data.proof.size() == 64 && data.proof.matches('^[a-f0-9]+$')
        && data.createdAt is timestamp;
    }

    function isValidStaffSecret(data) {
      return data.keys().hasAll([
          'staffId', 'proofHash', 'active', 'canAddProduct', 'canEditProduct',
          'canDeleteProduct', 'canManageOrders', 'canViewAnalytics', 'auditId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'staffId', 'proofHash', 'active', 'canAddProduct', 'canEditProduct',
          'canDeleteProduct', 'canManageOrders', 'canViewAnalytics', 'auditId', 'updatedAt'
        ])
        && isValidId(data.staffId)
        && data.staffId.size() >= 3 && data.staffId.size() <= 60
        && data.proofHash is string && data.proofHash.size() == 64 && data.proofHash.matches('^[a-f0-9]+$')
        && data.active is bool
        && data.canAddProduct is bool
        && data.canEditProduct is bool
        && data.canDeleteProduct is bool
        && data.canManageOrders is bool
        && data.canViewAnalytics is bool
        && isValidId(data.auditId)
        && data.updatedAt is timestamp;
    }

    function isValidStaffAccount(data) {
      return data.keys().hasAll([
          'staffId', 'username', 'displayName', 'active', 'status',
          'canAddProduct', 'canEditProduct', 'canDeleteProduct',
          'canManageOrders', 'canViewAnalytics', 'loginCount', 'auditId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'staffId', 'username', 'displayName', 'active', 'status',
          'canAddProduct', 'canEditProduct', 'canDeleteProduct',
          'canManageOrders', 'canViewAnalytics', 'loginCount', 'auditId',
          'lastLoginAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.staffId) && data.staffId.size() >= 3 && data.staffId.size() <= 60
        && isValidId(data.username) && data.username.size() >= 3 && data.username.size() <= 60
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.active is bool
        && data.status in ['active', 'suspended', 'deleted']
        && data.canAddProduct is bool
        && data.canEditProduct is bool
        && data.canDeleteProduct is bool
        && data.canManageOrders is bool
        && data.canViewAnalytics is bool
        && data.loginCount is int && data.loginCount >= 0 && data.loginCount <= 1000000
        && isValidId(data.auditId)
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserAccess(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'loginCount',
          'canAddPost', 'canEditPost', 'lastLoginAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'loginCount',
          'canAddPost', 'canEditPost', 'auditId', 'lastLoginAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 1000
        && data.loginCount is int && data.loginCount >= 1 && data.loginCount <= 1000000
        && data.canAddPost is bool
        && data.canEditPost is bool
        && (!('auditId' in data) || isValidId(data.auditId))
        && data.lastLoginAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'phone',
          'defaultAddress', 'city', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'phone',
          'defaultAddress', 'city', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 1000
        && data.phone is string && data.phone.size() <= 40
        && data.defaultAddress is string && data.defaultAddress.size() <= 300
        && data.city is string && data.city.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
          'stock', 'soldCount', 'imageUrl', 'summary', 'specs',
          'featured', 'status', 'lastOrderId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
          'stock', 'soldCount', 'imageUrl', 'summary', 'specs',
          'featured', 'status', 'lastOrderId', 'auditId', 'staffId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 60
        && data.category in ['Laptops', 'Processors', 'Graphics Cards', 'Monitors', 'Peripherals', 'Networking', 'Storage']
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 48 && data.sku.matches('^[a-zA-Z0-9_\\-]+$')
        && data.price is number && data.price > 0 && data.price <= 10000000
        && data.compareAtPrice is number && data.compareAtPrice >= 0 && data.compareAtPrice <= 10000000
        && data.stock is int && data.stock >= 0 && data.stock <= 100000
        && data.soldCount is int && data.soldCount >= 0 && data.soldCount <= 10000000
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 1000
        && data.imageUrl.matches('^(https?://|/src/assets/images/).+$')
        && data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 800
        && data.specs is list && data.specs.size() <= 16
        && (
          data.specs.size() == 0 || (
            data.specs[0] is map
            && data.specs[0].keys().hasAll(['label', 'value'])
            && data.specs[0].keys().hasOnly(['label', 'value'])
            && data.specs[0].label is string && data.specs[0].label.size() >= 1 && data.specs[0].label.size() <= 60
            && data.specs[0].value is string && data.specs[0].value.size() >= 1 && data.specs[0].value.size() <= 120
          )
        )
        && data.featured is bool
        && data.status in ['active', 'draft', 'archived']
        && data.lastOrderId is string && data.lastOrderId.size() >= 1 && data.lastOrderId.size() <= 128
        && (!('auditId' in data) || isValidId(data.auditId))
        && (!('staffId' in data) || isValidId(data.staffId))
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerEmail',
          'customerPhone', 'shippingAddress', 'city', 'paymentMethod',
          'items', 'subtotal', 'shippingFee', 'totalAmount',
          'status', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerEmail',
          'customerPhone', 'shippingAddress', 'city', 'paymentMethod',
          'items', 'subtotal', 'shippingFee', 'totalAmount',
          'status', 'notes', 'auditId', 'staffId', 'createdAt', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 40
        && data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 300
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.paymentMethod in ['cod', 'card_on_delivery', 'bank_transfer']
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 20
        && data.items[0] is map
        && data.items[0].keys().hasAll(['productId', 'title', 'sku', 'price', 'quantity', 'imageUrl'])
        && data.items[0].keys().hasOnly(['productId', 'title', 'sku', 'price', 'quantity', 'imageUrl'])
        && data.items[0].productId is string && isValidId(data.items[0].productId)
        && data.items[0].title is string && data.items[0].title.size() >= 1 && data.items[0].title.size() <= 160
        && data.items[0].sku is string && data.items[0].sku.size() >= 1 && data.items[0].sku.size() <= 48
        && data.items[0].price is number && data.items[0].price > 0
        && data.items[0].quantity is int && data.items[0].quantity >= 1 && data.items[0].quantity <= 50
        && data.items[0].imageUrl is string && data.items[0].imageUrl.size() <= 1000
        && data.subtotal is number && data.subtotal > 0
        && data.shippingFee is number && data.shippingFee >= 0 && data.shippingFee <= 10000
        && data.totalAmount is number && data.totalAmount == data.subtotal + data.shippingFee
        && data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled']
        && data.notes is string && data.notes.size() <= 500
        && (!('auditId' in data) || isValidId(data.auditId))
        && (!('staffId' in data) || isValidId(data.staffId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // ERP Validation Blueprints (hasOnly + per-field type checks enforce exact schema)
    // ---------------------------------------------------------
    function isValidErpBranch(data) {
      return data.keys().hasOnly(['branchId', 'name', 'location', 'phone', 'status', 'auditId', 'staffId', 'createdAt', 'updatedAt'])
        && isValidId(data.branchId) && data.branchId.size() <= 60
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 120
        && data.phone is string && data.phone.size() <= 40
        && data.status in ['active', 'archived']
        && isValidId(data.auditId)
        && (!('staffId' in data) || isValidId(data.staffId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidErpVendor(data) {
      return data.keys().hasOnly(['vendorId', 'name', 'company', 'phone', 'email', 'address', 'notes', 'status', 'auditId', 'staffId', 'createdAt', 'updatedAt'])
        && isValidId(data.vendorId) && data.vendorId.size() <= 60
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.company is string && data.company.size() <= 100
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 160
        && data.address is string && data.address.size() <= 240
        && data.notes is string && data.notes.size() <= 300
        && data.status in ['active', 'archived']
        && isValidId(data.auditId)
        && (!('staffId' in data) || isValidId(data.staffId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidErpCustomer(data) {
      return data.keys().hasOnly(['customerId', 'name', 'company', 'phone', 'email', 'address', 'city', 'notes', 'status', 'auditId', 'staffId', 'createdAt', 'updatedAt'])
        && isValidId(data.customerId) && data.customerId.size() <= 60
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.company is string && data.company.size() <= 100
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 160
        && data.address is string && data.address.size() <= 240
        && data.city is string && data.city.size() <= 80
        && data.notes is string && data.notes.size() <= 300
        && data.status in ['active', 'archived']
        && isValidId(data.auditId)
        && (!('staffId' in data) || isValidId(data.staffId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidErpModel(data) {
      return data.keys().hasOnly([
          'modelId', 'brand', 'modelName', 'productName', 'category',
          'defaultBuyPrice', 'defaultSellPrice', 'warranty', 'status', 'auditId', 'staffId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.modelId) && data.modelId.size() <= 80
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 60
        && data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 80
        && data.productName is string && data.productName.size() >= 2 && data.productName.size() <= 160
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 40
        && data.defaultBuyPrice is number && data.defaultBuyPrice >= 0 && data.defaultBuyPrice <= 10000000
        && data.defaultSellPrice is number && data.defaultSellPrice >= 0 && data.defaultSellPrice <= 10000000
        && data.warranty is string && data.warranty.size() <= 80
        && data.status in ['active', 'archived']
        && isValidId(data.auditId)
        && (!('staffId' in data) || isValidId(data.staffId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidErpSerial(data) {
      return data.keys().hasOnly([
          'serialId', 'serialNumber', 'modelId', 'productName', 'brand', 'modelName',
          'branchId', 'branchName', 'vendorId', 'vendorName', 'purchaseId', 'purchaseInvoice',
          'purchaseCost', 'salePrice', 'status', 'lastSaleId', 'lastSaleInvoice',
          'lastCustomerId', 'lastCustomerName', 'salespersonId', 'salespersonName',
          'history', 'auditId', 'staffId', 'purchasedAtIso', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.serialId) && data.serialId.size() <= 80
        && data.serialNumber is string && data.serialNumber.size() >= 2 && data.serialNumber.size() <= 80
        && data.modelId is string && data.modelId.size() <= 80
        && data.productName is string && data.productName.size() <= 160
        && data.brand is string && data.brand.size() <= 60
        && data.modelName is string && data.modelName.size() <= 80
        && data.branchId is string && data.branchId.size() <= 60
        && data.branchName is string && data.branchName.size() <= 80
        && data.vendorId is string && data.vendorId.size() <= 60
        && data.vendorName is string && data.vendorName.size() <= 100
        && data.purchaseId is string && data.purchaseId.size() <= 128
        && data.purchaseInvoice is string && data.purchaseInvoice.size() <= 60
        && data.purchaseCost is number && data.purchaseCost >= 0 && data.purchaseCost <= 10000000
        && data.salePrice is number && data.salePrice >= 0 && data.salePrice <= 10000000
        && data.status in ['in_stock', 'sold', 'purchase_returned']
        && data.lastSaleId is string && data.lastSaleId.size() <= 128
        && data.lastSaleInvoice is string && data.lastSaleInvoice.size() <= 60
        && data.lastCustomerId is string && data.lastCustomerId.size() <= 60
        && data.lastCustomerName is string && data.lastCustomerName.size() <= 100
        && data.salespersonId is string && data.salespersonId.size() <= 60
        && data.salespersonName is string && data.salespersonName.size() <= 80
        && data.history is list && data.history.size() >= 1 && data.history.size() <= 50
        && data.history[0] is map
        && data.history[0].keys().hasOnly([
          'type', 'timestampIso', 'timestampMs', 'refId', 'invoiceNumber',
          'partyName', 'branchName', 'salespersonName', 'amount', 'profit', 'notes'
        ])
        && data.history[0].type in ['PURCHASE', 'SALE', 'PURCHASE_RETURN', 'SALES_RETURN']
        && data.history[0].timestampIso is string && data.history[0].timestampIso.size() <= 40
        && data.history[0].timestampMs is int && data.history[0].timestampMs > 0
        && data.history[0].refId is string && data.history[0].refId.size() <= 128
        && data.history[0].invoiceNumber is string && data.history[0].invoiceNumber.size() <= 60
        && data.history[0].partyName is string && data.history[0].partyName.size() <= 100
        && data.history[0].branchName is string && data.history[0].branchName.size() <= 80
        && data.history[0].salespersonName is string && data.history[0].salespersonName.size() <= 80
        && data.history[0].amount is number
        && data.history[0].profit is number
        && data.history[0].notes is string && data.history[0].notes.size() <= 240
        && isValidId(data.auditId)
        && (!('staffId' in data) || (data.staffId is string && data.staffId.size() <= 60))
        && data.purchasedAtIso is string && data.purchasedAtIso.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidErpPurchase(data) {
      return data.keys().hasOnly([
          'purchaseId', 'invoiceNumber', 'vendorId', 'vendorName', 'branchId', 'branchName',
          'items', 'totalAmount', 'totalUnits', 'notes', 'status', 'createdByName',
          'purchaseDateIso', 'auditId', 'staffId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.purchaseId) && data.purchaseId.size() <= 128
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 2 && data.invoiceNumber.size() <= 60
        && data.vendorId is string && data.vendorId.size() <= 60
        && data.vendorName is string && data.vendorName.size() <= 100
        && data.branchId is string && data.branchId.size() <= 60
        && data.branchName is string && data.branchName.size() <= 80
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.items[0] is map
        && data.items[0].keys().hasOnly(['modelId', 'productName', 'brand', 'modelName', 'quantity', 'unitCost', 'lineTotal', 'serialNumbers'])
        && data.items[0].modelId is string
        && data.items[0].productName is string
        && data.items[0].brand is string
        && data.items[0].modelName is string
        && data.items[0].quantity is int && data.items[0].quantity >= 1 && data.items[0].quantity <= 100
        && data.items[0].unitCost is number && data.items[0].unitCost >= 0
        && data.items[0].lineTotal is number && data.items[0].lineTotal >= 0
        && data.items[0].serialNumbers is list && data.items[0].serialNumbers.size() >= 1 && data.items[0].serialNumbers.size() <= 100
        && data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 1000000000
        && data.totalUnits is int && data.totalUnits >= 1 && data.totalUnits <= 500
        && data.notes is string && data.notes.size() <= 300
        && data.status in ['completed', 'partial_return', 'returned']
        && data.createdByName is string && data.createdByName.size() <= 80
        && data.purchaseDateIso is string && data.purchaseDateIso.size() <= 40
        && isValidId(data.auditId)
        && (!('staffId' in data) || (data.staffId is string && data.staffId.size() <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidErpSale(data) {
      return data.keys().hasOnly([
          'saleId', 'invoiceNumber', 'customerId', 'customerName', 'branchId', 'branchName',
          'salespersonId', 'salespersonUsername', 'salespersonName', 'items',
          'totalRevenue', 'totalCost', 'totalProfit', 'totalUnits',
          'returnedUnits', 'returnedRevenue', 'returnedProfit',
          'saleMonth', 'saleDateIso', 'notes', 'status', 'auditId', 'staffId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.saleId) && data.saleId.size() <= 128
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 2 && data.invoiceNumber.size() <= 60
        && data.customerId is string && data.customerId.size() <= 60
        && data.customerName is string && data.customerName.size() <= 100
        && data.branchId is string && data.branchId.size() <= 60
        && data.branchName is string && data.branchName.size() <= 80
        && isValidId(data.salespersonId) && data.salespersonId.size() <= 60
        && data.salespersonUsername is string && data.salespersonUsername.size() <= 60
        && data.salespersonName is string && data.salespersonName.size() <= 80
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.items[0] is map
        && data.items[0].keys().hasOnly([
          'serialId', 'serialNumber', 'modelId', 'productName', 'brand', 'modelName',
          'unitCost', 'unitPrice', 'profit', 'returned'
        ])
        && data.items[0].serialId is string
        && data.items[0].serialNumber is string
        && data.items[0].modelId is string
        && data.items[0].productName is string
        && data.items[0].brand is string
        && data.items[0].modelName is string
        && data.items[0].unitCost is number && data.items[0].unitCost >= 0
        && data.items[0].unitPrice is number && data.items[0].unitPrice >= 0
        && data.items[0].profit is number
        && data.items[0].returned is bool
        && data.totalRevenue is number && data.totalRevenue >= 0 && data.totalRevenue <= 1000000000
        && data.totalCost is number && data.totalCost >= 0 && data.totalCost <= 1000000000
        && data.totalProfit is number
        && data.totalUnits is int && data.totalUnits >= 1 && data.totalUnits <= 500
        && data.returnedUnits is int && data.returnedUnits >= 0 && data.returnedUnits <= data.totalUnits
        && data.returnedRevenue is number && data.returnedRevenue >= 0 && data.returnedRevenue <= data.totalRevenue
        && data.returnedProfit is number
        && data.saleMonth is string && data.saleMonth.size() == 7
        && data.saleDateIso is string && data.saleDateIso.size() <= 40
        && data.notes is string && data.notes.size() <= 300
        && data.status in ['completed', 'partial_return', 'returned']
        && isValidId(data.auditId)
        && (!('staffId' in data) || (data.staffId is string && data.staffId.size() <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidErpReturn(data) {
      return data.keys().hasOnly([
          'returnId', 'returnNumber', 'returnType', 'serialId', 'serialNumber', 'modelId', 'productName',
          'branchId', 'branchName', 'partyId', 'partyName', 'refInvoiceNumber',
          'amount', 'profitAdjustment', 'salespersonId', 'salespersonName', 'reason',
          'returnMonth', 'returnDateIso', 'status', 'auditId', 'staffId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.returnId) && data.returnId.size() <= 128
        && data.returnNumber is string && data.returnNumber.size() >= 2 && data.returnNumber.size() <= 60
        && data.returnType in ['purchase_return', 'sales_return']
        && data.serialId is string && data.serialId.size() <= 80
        && data.serialNumber is string && data.serialNumber.size() <= 80
        && data.modelId is string && data.modelId.size() <= 80
        && data.productName is string && data.productName.size() <= 160
        && data.branchId is string && data.branchId.size() <= 60
        && data.branchName is string && data.branchName.size() <= 80
        && data.partyId is string && data.partyId.size() <= 60
        && data.partyName is string && data.partyName.size() <= 100
        && data.refInvoiceNumber is string && data.refInvoiceNumber.size() <= 60
        && data.amount is number && data.amount >= 0 && data.amount <= 100000000
        && data.profitAdjustment is number
        && data.salespersonId is string && data.salespersonId.size() <= 60
        && data.salespersonName is string && data.salespersonName.size() <= 80
        && data.reason is string && data.reason.size() <= 300
        && data.returnMonth is string && data.returnMonth.size() == 7
        && data.returnDateIso is string && data.returnDateIso.size() <= 40
        && data.status == 'completed'
        && isValidId(data.auditId)
        && (!('staffId' in data) || (data.staffId is string && data.staffId.size() <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection Rules (Auth/Proof -> Static Validation -> Relational)
    // ---------------------------------------------------------
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(adminId) && isValidAdmin(incoming())
        && incoming().uid == adminId
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(adminId) && adminId != request.auth.uid && isAdmin();
    }

    match /adminProofs/{proofId} {
      allow read: if false;
      allow create: if isValidId(proofId)
        && isValidAdminProof(incoming())
        && incoming().createdAt == request.time
        && isValidAdminProofToken(incoming().proof);
      allow update, delete: if false;
    }

    match /adminConfig/{configId} {
      allow get, list: if false;
      allow create, update: if isValidId(configId)
        && configId == 'credentials'
        && isValidAdminCredential(incoming())
        && incoming().updatedAt == request.time
        && (isAdmin() || isValidAdminProofBatch(incoming().auditId));
      allow delete: if false;
    }

    match /staffProofs/{proofId} {
      allow read: if false;
      allow create: if isValidId(proofId)
        && isValidStaffProof(incoming())
        && incoming().createdAt == request.time
        && isValidStaffProofToken(incoming().staffId, incoming().proof);
      allow update, delete: if false;
    }

    match /staffSecrets/{staffId} {
      allow get, list: if false;
      allow create: if isValidId(staffId)
        && isValidStaffSecret(incoming())
        && incoming().staffId == staffId
        && incoming().updatedAt == request.time
        && (isAdmin() || isValidAdminProofBatch(incoming().auditId));
      allow update: if isValidId(staffId)
        && isValidStaffSecret(incoming())
        && incoming().staffId == existing().staffId
        && incoming().updatedAt == request.time
        && (isAdmin() || isValidAdminProofBatch(incoming().auditId));
      allow delete: if false;
    }

    match /staffAccounts/{staffId} {
      allow get: if isValidId(staffId) && (existing().status in ['active', 'suspended'] || isAdmin());
      allow list: if resource.data.status in ['active', 'suspended'] || isAdmin();
      allow create: if isValidId(staffId)
        && isValidStaffAccount(incoming())
        && incoming().staffId == staffId
        && incoming().loginCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || isValidAdminProofBatch(incoming().auditId));
      allow update: if isValidId(staffId)
        && isValidStaffAccount(incoming())
        && incoming().staffId == existing().staffId
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Super Admin updates manager status or checkbox permissions
          (
            (isAdmin() || isValidAdminProofBatch(incoming().auditId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'active', 'status',
              'canAddProduct', 'canEditProduct', 'canDeleteProduct',
              'canManageOrders', 'canViewAnalytics', 'auditId', 'updatedAt'
            ])
          ) ||
          // Tier 2: Verified manager records login event
          (
            isValidStaffLoginBatch(staffId, incoming().auditId)
            && incoming().loginCount == existing().loginCount + 1
            && incoming().lastLoginAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'loginCount', 'lastLoginAt', 'auditId', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /userAccess/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isValidUserAccess(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            isVerifiedUser()
            && isOwner(userId)
            && incoming().loginCount == 1
            && incoming().canAddPost == false
            && incoming().canEditPost == false
            && incoming().lastLoginAt == request.time
            && !('auditId' in incoming())
          ) ||
          isAdmin() ||
          (('auditId' in incoming()) && isValidAdminProofBatch(incoming().auditId))
        );
      allow update: if isValidId(userId)
        && isValidUserAccess(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (
              isAdmin() ||
              (('auditId' in incoming()) && isValidAdminProofBatch(incoming().auditId))
            )
            && incoming().diff(existing()).affectedKeys().hasOnly(['canAddPost', 'canEditPost', 'auditId', 'updatedAt'])
          ) ||
          (
            isVerifiedUser()
            && isOwner(userId)
            && incoming().loginCount == existing().loginCount + 1
            && incoming().canAddPost == existing().canAddPost
            && incoming().canEditPost == existing().canEditPost
            && incoming().lastLoginAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'loginCount', 'lastLoginAt', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'phone', 'defaultAddress', 'city', 'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().status == 'active' || isAdmin());
      allow list: if resource.data.status == 'active' || isAdmin();
      allow create: if isValidId(productId) && isValidProduct(incoming())
        && incoming().soldCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().createdBy == request.auth.uid) ||
          (canUserAddPost() && incoming().createdBy == request.auth.uid && !('auditId' in incoming()) && !('staffId' in incoming())) ||
          (('auditId' in incoming()) && !('staffId' in incoming()) && isValidAdminProofBatch(incoming().auditId) && incoming().createdBy == 'admin_portal') ||
          (('auditId' in incoming()) && ('staffId' in incoming()) && isValidStaffPermissionBatch(incoming().staffId, incoming().auditId, 'add') && incoming().createdBy == incoming().staffId)
        );
      allow update: if isValidId(productId) && isValidProduct(incoming()) && (
        // Tier 1a: Super Admin full catalog & inventory update
        (
          (
            isAdmin() ||
            (('auditId' in incoming()) && !('staffId' in incoming()) && isValidAdminProofBatch(incoming().auditId))
          )
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
            'stock', 'imageUrl', 'summary', 'specs', 'featured', 'status', 'auditId', 'updatedAt'
          ])
        ) ||
        // Tier 1b: Manager with canEditProduct modifying active/draft product or stock
        (
          ('auditId' in incoming())
          && ('staffId' in incoming())
          && isValidStaffPermissionBatch(incoming().staffId, incoming().auditId, 'edit')
          && incoming().status in ['active', 'draft']
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
            'stock', 'imageUrl', 'summary', 'specs', 'featured', 'status', 'staffId', 'auditId', 'updatedAt'
          ])
        ) ||
        // Tier 1c: Manager with canDeleteProduct archiving product
        (
          ('auditId' in incoming())
          && ('staffId' in incoming())
          && isValidStaffPermissionBatch(incoming().staffId, incoming().auditId, 'delete')
          && incoming().status == 'archived'
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'staffId', 'auditId', 'updatedAt'
          ])
        ) ||
        // Tier 1d: Storefront permitted editor (canEditPost) modifying active/draft listing
        (
          canUserEditPost()
          && !('auditId' in incoming())
          && !('staffId' in incoming())
          && incoming().status in ['active', 'draft']
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'brand', 'category', 'sku', 'price', 'compareAtPrice',
            'stock', 'imageUrl', 'summary', 'specs', 'featured', 'status', 'updatedAt'
          ])
        ) ||
        // Tier 2: Verified Customer atomic stock deduction coupled with Order creation
        (
          isVerifiedUser()
          && existing().status == 'active'
          && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'soldCount', 'lastOrderId', 'updatedAt'])
          && incoming().stock < existing().stock
          && incoming().stock >= 0
          && incoming().soldCount == existing().soldCount + (existing().stock - incoming().stock)
          && incoming().updatedAt == request.time
          && isValidId(incoming().lastOrderId)
          && existsAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId))
          && getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderId)).data.createdAt == request.time
        )
      );
      allow delete: if isVerifiedUser() && isValidId(productId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/products/$(incoming().items[0].productId))
        && get(/databases/$(database)/documents/products/$(incoming().items[0].productId)).data.price == incoming().items[0].price
        && (incoming().items.size() > 1 || incoming().subtotal == incoming().items[0].price * incoming().items[0].quantity);
      allow update: if isValidId(orderId) && isValidOrder(incoming())
        && incoming().orderNumber == existing().orderNumber
        && incoming().userId == existing().userId
        && incoming().items == existing().items
        && incoming().subtotal == existing().subtotal
        && incoming().shippingFee == existing().shippingFee
        && incoming().totalAmount == existing().totalAmount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1a: Super Admin order lifecycle management
          (
            (
              isAdmin() ||
              (('auditId' in incoming()) && !('staffId' in incoming()) && isValidAdminProofBatch(incoming().auditId))
            )
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'auditId', 'updatedAt'])
          ) ||
          // Tier 1b: Manager with canManageOrders permission
          (
            ('auditId' in incoming())
            && ('staffId' in incoming())
            && isValidStaffPermissionBatch(incoming().staffId, incoming().auditId, 'orders')
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'staffId', 'auditId', 'updatedAt'])
          ) ||
          // Tier 2: Customer may only cancel their own pending order
          (
            isVerifiedUser()
            && existing().userId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // ERP Collections
    // ---------------------------------------------------------
    match /erpBranches/{branchId} {
      allow get: if isValidId(branchId) && (existing().status in ['active', 'archived'] || isAdmin());
      allow list: if resource.data.status in ['active', 'archived'] || isAdmin();
      allow create: if isValidId(branchId) && isValidErpBranch(incoming())
        && incoming().branchId == branchId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAuthorizedErpSetup(incoming());
      allow update: if isValidId(branchId) && isValidErpBranch(incoming())
        && incoming().branchId == existing().branchId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'phone', 'status', 'staffId', 'auditId', 'updatedAt'])
        && isAuthorizedErpSetup(incoming());
      allow delete: if false;
    }

    match /erpVendors/{vendorId} {
      allow get: if isValidId(vendorId) && (existing().status in ['active', 'archived'] || isAdmin());
      allow list: if resource.data.status in ['active', 'archived'] || isAdmin();
      allow create: if isValidId(vendorId) && isValidErpVendor(incoming())
        && incoming().vendorId == vendorId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAuthorizedErpSetup(incoming());
      allow update: if isValidId(vendorId) && isValidErpVendor(incoming())
        && incoming().vendorId == existing().vendorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'company', 'phone', 'email', 'address', 'notes', 'status', 'staffId', 'auditId', 'updatedAt'])
        && isAuthorizedErpSetup(incoming());
      allow delete: if false;
    }

    match /erpCustomers/{customerId} {
      allow get: if isValidId(customerId) && (existing().status in ['active', 'archived'] || isAdmin());
      allow list: if resource.data.status in ['active', 'archived'] || isAdmin();
      allow create: if isValidId(customerId) && isValidErpCustomer(incoming())
        && incoming().customerId == customerId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAuthorizedErpAny(incoming());
      allow update: if isValidId(customerId) && isValidErpCustomer(incoming())
        && incoming().customerId == existing().customerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'company', 'phone', 'email', 'address', 'city', 'notes', 'status', 'staffId', 'auditId', 'updatedAt'])
        && isAuthorizedErpAny(incoming());
      allow delete: if false;
    }

    match /erpModels/{modelId} {
      allow get: if isValidId(modelId) && (existing().status in ['active', 'archived'] || isAdmin());
      allow list: if resource.data.status in ['active', 'archived'] || isAdmin();
      allow create: if isValidId(modelId) && isValidErpModel(incoming())
        && incoming().modelId == modelId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAuthorizedErpSetup(incoming());
      allow update: if isValidId(modelId) && isValidErpModel(incoming())
        && incoming().modelId == existing().modelId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'brand', 'modelName', 'productName', 'category',
          'defaultBuyPrice', 'defaultSellPrice', 'warranty', 'status', 'staffId', 'auditId', 'updatedAt'
        ])
        && isAuthorizedErpSetup(incoming());
      allow delete: if false;
    }

    match /erpSerials/{serialId} {
      allow get: if isValidId(serialId) && (existing().status in ['in_stock', 'sold', 'purchase_returned'] || isAdmin());
      allow list: if resource.data.status in ['in_stock', 'sold', 'purchase_returned'] || isAdmin();
      allow create: if isValidId(serialId) && isValidErpSerial(incoming())
        && incoming().serialId == serialId
        && incoming().status == 'in_stock'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAuthorizedErpSetup(incoming());
      allow update: if isValidId(serialId) && isValidErpSerial(incoming())
        && incoming().serialId == existing().serialId
        && incoming().serialNumber == existing().serialNumber
        && incoming().modelId == existing().modelId
        && incoming().purchaseId == existing().purchaseId
        && incoming().purchaseCost == existing().purchaseCost
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().history.size() >= existing().history.size()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'branchId', 'branchName', 'salePrice', 'status',
          'lastSaleId', 'lastSaleInvoice', 'lastCustomerId', 'lastCustomerName',
          'salespersonId', 'salespersonName', 'history', 'staffId', 'auditId', 'updatedAt'
        ])
        && isAuthorizedErpAny(incoming());
      allow delete: if false;
    }

    match /erpPurchases/{purchaseId} {
      allow get: if isValidId(purchaseId) && (existing().status in ['completed', 'partial_return', 'returned'] || isAdmin());
      allow list: if resource.data.status in ['completed', 'partial_return', 'returned'] || isAdmin();
      allow create: if isValidId(purchaseId) && isValidErpPurchase(incoming())
        && incoming().purchaseId == purchaseId
        && incoming().status == 'completed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAuthorizedErpSetup(incoming());
      allow update: if isValidId(purchaseId) && isValidErpPurchase(incoming())
        && incoming().purchaseId == existing().purchaseId
        && incoming().vendorId == existing().vendorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'staffId', 'auditId', 'updatedAt'])
        && isAuthorizedErpAny(incoming());
      allow delete: if false;
    }

    match /erpSales/{saleId} {
      allow get: if isValidId(saleId) && (existing().status in ['completed', 'partial_return', 'returned'] || isAdmin());
      allow list: if resource.data.status in ['completed', 'partial_return', 'returned'] || isAdmin();
      allow create: if isValidId(saleId) && isValidErpSale(incoming())
        && incoming().saleId == saleId
        && incoming().status == 'completed'
        && incoming().returnedUnits == 0
        && incoming().returnedRevenue == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/staffAccounts/$(incoming().salespersonId))
        && isAuthorizedErpOrder(incoming());
      allow update: if isValidId(saleId) && isValidErpSale(incoming())
        && incoming().saleId == existing().saleId
        && incoming().customerId == existing().customerId
        && incoming().salespersonId == existing().salespersonId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'items', 'returnedUnits', 'returnedRevenue', 'returnedProfit',
          'status', 'notes', 'staffId', 'auditId', 'updatedAt'
        ])
        && isAuthorizedErpOrder(incoming());
      allow delete: if false;
    }

    match /erpReturns/{returnId} {
      allow get: if isValidId(returnId) && (existing().status == 'completed' || isAdmin());
      allow list: if resource.data.status == 'completed' || isAdmin();
      allow create: if isValidId(returnId) && isValidErpReturn(incoming())
        && incoming().returnId == returnId
        && incoming().status == 'completed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAuthorizedErpAny(incoming());
      allow update, delete: if false;
    }
  }
}
